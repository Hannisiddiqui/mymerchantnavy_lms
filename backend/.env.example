APP_NAME="My Merchant Navy"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=mmp_lms
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@mymerchantnavy.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---- My Merchant Navy LMS ----
STUDENT_APP_URL=http://localhost:3000
# How students log in: email (a one-time code is emailed) or phone (the SMS login, kept but switched off).
# The student app must use the same value: NEXT_PUBLIC_LOGIN_METHOD.
LMS_LOGIN_METHOD=email

# Devices a student can be logged in on at once. 0 = no limit: they stay logged in until they log out themselves.
LMS_MAX_DEVICES=0

# Email login codes: "log" writes the code to storage/logs/laravel.log (development), "mail" sends a real email.
OTP_EMAIL_DRIVER=log

# Only for the phone login (LMS_LOGIN_METHOD=phone): "log" (development) or "twilio".
OTP_DRIVER=log
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Protected PDFs need poppler's pdftoppm (Linux: apt install poppler-utils)
# LMS_PDFTOPPM=/usr/bin/pdftoppm
# LMS_WATERMARK_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf

# Production: use QUEUE_CONNECTION=database (or redis) and run: php artisan queue:work

# AI question reader (Question imports -> Parse PDF with AI). Set ONE key; the first one set is used (Gemini, then OpenAI, then Claude).
# Gemini key: https://aistudio.google.com/apikey   (cheapest; has a free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# OpenAI key: https://platform.openai.com/api-keys
VERTEX_API_KEY=
VERTEX_MODEL=gemini-3.8-flash
VERTEX_FALLBACK_MODEL=gemini-3.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Claude key: https://console.anthropic.com (most accurate, most expensive)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# auto | gemini | openai | anthropic
AI_PROVIDER=auto

# PyMuPDF helper for reading PDFs (pip install pymupdf). Set if python is not on the PATH
# LMS_PYTHON=python
