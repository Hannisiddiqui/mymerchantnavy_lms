# Pilot on Hostinger Business hosting (MySQL/MariaDB). Copy to backend/.env on the server and fill in the three blanks.
# Steps: docs/HOSTINGER.md
APP_NAME="My Merchant Navy"
APP_ENV=production
APP_DEBUG=false
APP_KEY=                       # php artisan key:generate
APP_URL=https://api.mymerchantnavy.com
ADMIN_DOMAIN=                  # empty: the admin panel is at https://api.mymerchantnavy.com/admin
STUDENT_APP_URL=https://lms.mymerchantnavy.com
CORS_ALLOWED_ORIGINS=https://lms.mymerchantnavy.com
TRUSTED_PROXIES=*
LOG_CHANNEL=stack
LOG_LEVEL=warning

# Hostinger: hPanel > Databases > Management. The name and user get a prefix (u563028037_...).
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database      # a cron job runs the queue (see docs/HOSTINGER.md)
FILESYSTEM_DISK=local

# Students log in with their email: a one-time code is emailed (Brevo). Never set OTP_FIXED_CODE in production.
LMS_LOGIN_METHOD=email
OTP_EMAIL_DRIVER=mail
LMS_MAX_DEVICES=0

# Brevo: SMTP & API > SMTP. MAIL_FROM_ADDRESS must be a sender verified in Brevo.
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="support.mymerchantnavy@gmail.com"
MAIL_FROM_NAME="My Merchant Navy"

# PDF reader (PyMuPDF installed in ~/lms-venv with: python3.11 -m venv ~/lms-venv && ~/lms-venv/bin/pip install pymupdf==1.26.4)
LMS_PYTHON=/home/u563028037/lms-venv/bin/python

GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_PROVIDER=auto

# Link with the WordPress site: create it with  bash ~/lms/backend/tools/set-wp-secret.sh  (see docs/WORDPRESS.md)
LMS_WP_SECRET=
